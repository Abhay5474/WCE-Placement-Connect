# ===== Server =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== Database =====
MONGO_URI=mongodb://127.0.0.1:27017/wceconnect_ai

# ===== Institution =====
# Configurable institutional email domain (do NOT hard-code in code)
COLLEGE_EMAIL_DOMAIN=walchandcollege.edu.in
INSTITUTION_NAME=Walchand College of Engineering
# Set true to require verified email before login
REQUIRE_EMAIL_VERIFICATION=false

# ===== Auth / JWT =====
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===== AI =====
# Provider-agnostic layer: mock | openai | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
# Rate limit for AI assistant requests (per user per window)
AI_RATE_LIMIT=30

# ===== Vector search =====
# atlas = MongoDB Atlas Vector Search, local = in-memory cosine fallback
VECTOR_BACKEND=local
ATLAS_VECTOR_INDEX=vector_index

# ===== Email (optional; logs to console if unset) =====
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@wceconnect.ai
