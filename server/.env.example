# ===== Server =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== Database =====
# Local: mongodb://127.0.0.1:27017/wceconnect_ai
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb://127.0.0.1:27017/wceconnect_ai
# Database name (applied by the driver; the URI need not include one)
MONGO_DB=wceconnect_ai
# If a mongodb+srv:// URI fails with "querySrv ECONNREFUSED" (common on college/
# VPN networks), point Node at a public DNS server. Leave blank for local Mongo.
DNS_SERVERS=1.1.1.1,8.8.8.8

# ===== Institution =====
# Configurable institutional email domain (do NOT hard-code in code)
COLLEGE_EMAIL_DOMAIN=walchandcollege.edu.in
INSTITUTION_NAME=Walchand College of Engineering
# Set true to require verified email before login
REQUIRE_EMAIL_VERIFICATION=false
# Registration is OPEN by default (any email). Set true to restrict to the
# COLLEGE_EMAIL_DOMAIN above. Reading placement content is always public;
# adding experiences always requires admin-granted contributor access.
RESTRICT_EMAIL_DOMAIN=false

# ===== Auth / JWT =====
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===== AI (Gemini + Groq only) =====
# CHAT/LLM provider (summaries, assistant, grammar): mock | gemini | groq
# Recommended: groq (fast Llama) for chat + gemini for embeddings.
AI_PROVIDER=groq
# EMBEDDINGS provider (semantic search / RAG): mock | gemini
# Groq has no embeddings API, so use gemini. Blank = auto (gemini if key present).
EMBEDDING_PROVIDER=gemini

# Groq (get a key at https://console.groq.com/keys)
# Model names change over time — check https://console.groq.com/docs/models for
# the current list your key can access (e.g. openai/gpt-oss-20b, openai/gpt-oss-120b).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# For gpt-oss reasoning models: low|medium|high. 'low' minimizes token usage so
# the free tier isn't exhausted (blank to omit). Ignored by non-gpt-oss models.
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=1024

# Google Gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Rate limit for AI requests (per user per minute)
AI_RATE_LIMIT=30

# ===== Vector search =====
# atlas = MongoDB Atlas Vector Search, local = in-memory cosine fallback
VECTOR_BACKEND=local
ATLAS_VECTOR_INDEX=vector_index

# ===== Email (optional; logs to console if unset) =====
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@wceconnect.ai
